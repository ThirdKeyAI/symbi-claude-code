{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "timeout": 10,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/install-check.sh"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/policy-guard.sh"
            ],
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/audit-log.sh"
            ]
          }
        ]
      }
    ]
  }
}
