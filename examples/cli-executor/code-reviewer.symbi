metadata {
    version = "1.0.0"
    description = "Read-only review through governed source tools"
    executor = "claude_code"
    allowed_tools = "read_file,list_files,grep_files"
}

// Requires the separate control project, manifests and source roots from
// symbi init --sandbox landlock --profile dev-agent.
agent dev() {
    capabilities = ["read", "analyze"]
    with timeout = 300.seconds {}
}
